&pwm6 {
    status = "okay";
};

&pwm7 {
    status = "disabled";
};

&rk_headset {
    status = "disabled";
};

&rkcif_mipi_lvds {
	port {
		cif_mipi_p_ep: endpoint {
			data-lanes = <0x01 0x02>;
			remote-endpoint = <&mipi_csi2_psp1_ep0>;
		};
	};
};

&mipi_csi2_hw {
	status = "disabled";

	ports {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		port@0 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00>;

			mipi_csi2_psp0_ep1: endpoint@1 {
				data-lanes = <0x01 0x02>;
				reg = <0x01>;
				remote-endpoint = <&csi2_dphy2_psp1_ep1>;
			};
		};

		port@1 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;

			mipi_csi2_psp1_ep0: endpoint@0 {
				data-lanes = <0x01 0x02>;
				reg = <0x00>;
				remote-endpoint = <&cif_mipi_p_ep>;
			};
		};
	};
};

&csi2_dphy0 {
	ports {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		port@0 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00>;

			csi2_dphy0_psp0_ep1: endpoint@1 {
				data-lanes = <0x01 0x02 0x03 0x04>;
				reg = <0x01>;
				remote-endpoint = <&gc8034_ep>;
			};
		};

		port@1 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;

			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&rkisp_vir0_ep>;
			};
		};
	};
};

&csi2_dphy1 {
	ports {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		port@0 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00>;

			csi2_dphy1_psp0_ep1: endpoint@1 {
				data-lanes = <0x01 0x02>;
				reg = <0x01>;
				remote-endpoint = <&ov5695_ep>;
			};
		};

		port@1 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;

			csi2_dphy1_psp1_ep1: endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&rkisp_vir0_ep>;
			};
		};
	};
};

&csi2_dphy2 {
	ports {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		port@0 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00>;

			csi2_dphy2_psp0_ep1: endpoint@1 {
				data-lanes = <0x01 0x02>;
				reg = <0x01>;
				remote-endpoint = <&gc5025_ep>;
			};
		};

		port@1 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;

			csi2_dphy2_psp1_ep1: endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&mipi_csi2_psp0_ep1>;
			};
		};
	};
};

&rkisp_vir0 {
    port {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		rkisp_vir0_ep: endpoint@0 {
			reg = <0x00>;
			remote-endpoint = <&csi2_dphy1_psp1_ep1>;
		};
	};
};

&rkcif_dvp {
	port {
		rkcif_dvp_ep: endpoint {
			bus-width = <0x08>;
			hsync-active = <0x01>;
			vsync-active = <0x00>;
			remote-endpoint = <&gc2145_ep>;
		};
	};
};

&edp {
    force-hpd;
    ports {
		port@1 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;

			edp_psp1_ep: endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <&edp_panel_ep>;
			};
		};
    };
};

&rk809_sound {
    compatible = "simple-audio-card";

	simple-audio-card,format = "i2s";
	simple-audio-card,mclk-fs = <256>;
	simple-audio-card,name = "rockchip,rk809-codec";

	status = "okay";

	simple-audio-card,codec {
		sound-dai = <&rk809_codec 0>;
	};

	simple-audio-card,cpu {
		sound-dai = <&i2s1_8ch>;
	};
};

&hdmi_sound {
    compatible = "rockchip,hdmi-sound";
	rockchip,card-name = "hdmi";
	rockchip,cpu = <&i2s0_8ch>;
	rockchip,codec = <&hdmi>;
	rockchip,mclk-fs = <128>;
	status = "okay";
};

&i2s0_8ch {
    status = "disabled";
};

&hdmi {
    status = "disabled";
};

&vp0 {
	rockchip,plane-mask = <0x00>;
	rockchip,primary-plane = <0x00>;
};

&vp1 {
	rockchip,plane-mask = <0x15>;
	rockchip,primary-plane = <0x04>;
};

&vp2 {
	rockchip,plane-mask = <0x2a>;
	rockchip,primary-plane = <0x05>;
};

&dsi0 {
    #phy-cells = <0>;
	rockchip,lane-rate = <0x1a4>;
    phy-names = "mipi_dphy";
	status = "disabled";
    panel@0 {
        init-delay-ms = <0x78>;
		mipi_lcd_index = <0x09>;
		panel-init-sequence;
		pinctrl-0 = <&lcd0gp>;
		reset-gpios = <&gpio3 0x1a 0x01>;
    };
};

&dsi1 {
    phy-names = "mipi_dphy";
	status = "disabled";
    panel@0 {
        init-delay-ms = <0x78>;
		mipi_lcd_index = <0x09>;
		panel-init-sequence;
		panel-init-sequence = <0x5f80111 0x5f80129>;
		pinctrl-0 = <&lcd0gp>;
		reset-gpios = <&gpio3 0x1a 0x01>;
    };
};

&gmac1 {
	phy-mode = "rmii";

	snps,reset-gpio = <&gpio4 0x0b GPIO_ACTIVE_LOW>;

    assigned-clock-rates = <0 50000000>;
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RMII_SPEED>;

	pinctrl-0 = <&gmac1m1_miim>, <&gmac1m1_clkinout>, <&gmac1m1_tx_bus2>, <&gmac1m1_rx_bus2>, <&gmac1m1_rx_er>;

	clock_in_out = "output";
    local-mac-address = [86 86 df 56 cc 7d];
	status = "okay";
};

&display_subsystem {
    route {
        route_dsi0 {
            status = "disabled";
        };

        route_hdmi {
            status = "disabled";
        };
        
        route-lvds {
            status = "disabled";
            cubic_lut,offset = <8192>;
            logo,bpp = <16>;
            logo,width = <1920>;
            logo,height = <1080>;
            logo,offset = <8302592>;
            logo,ymirror = <0>;
            overscan,left_margin = <100>;
            overscan,right_margin = <100>;
            overscan,top_margin = <100>;
            overscan,bottom_margin = <100>;
            video,aspect_ratio = <0>;
            video,clock = <80000>;
            video,crtc_hsync_end = <1500>;
            video,crtc_vsync_end = <777>;
            video,flags = <10>;
            video,hdisplay = <1368>;
            video,vdisplay = <768>;
            video,vrefresh = <60>;
        };

		route_lvds1: route-lvds1 {
			status = "disabled";
			logo,uboot = "logo.bmp";
			logo,kernel = "logo_kernel.bmp";
			logo,mode = "center";
			charge_logo,mode = "center";
			connect = <&vp1_out_lvds1>;
		};
    };
};

&video_phy0 {
    reset-names = "rst";
};

&video_phy1 {
    reset-names = "rst";
};

&can0 {
	assigned-clock-rates = <150000000>;
	assigned-clocks = <&cru 0x141>;
	pinctrl-0 = <&can0m1_pins>;
	pinctrl-names = "default";
};

&can1 {
	//assigned-clock-rates = <150000000>;
	assigned-clock-rates = <200000000>;
	assigned-clocks = <&cru 0x143>;
