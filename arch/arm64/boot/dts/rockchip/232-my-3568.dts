    ir_key1 {
		rockchip,key_table = <0xf0 0x74 0xad 0x66 0xef 0x8b 0xa7 0x71 0xa1 0x179 0xb2 0x67 0xee 0xf1 0xa3 0x73 0xa8 0x69 0xa4 0xe8 0xa0 0x6a 0xab 0x72 0xa9 0x0f 0xa5 0x6c 0xed 0xf2 0xac 0x9e 0xe8 0x02 0xe4 0x03 0xe0 0x04 0xe9 0x05 0xe5 0x06 0xe1 0x07 0xea 0x08 0xe6 0x09 0xe2 0x0a 0xe7 0x0b 0xeb 0x34 0xe3 0x6f 0xec 0xa8 0xaf 0xd0 0xa6 0xa4 0xaa 0xa4>;
