#include "rk3568-evb2-lp4x-v10.dtsi"
#include "rk3568-android.dtsi"


/ {
    serial-number = "5182024030600284";

    
    backlight2 {
		default-brightness-level = <0x80>;
		enable-gpios = <&gpio3 0x18 0x00>;
		lcd_backlight_max = <0xff>;
		lcd_backlight_min = <0x32>;
		lcd_pwm_pol = <0x01>;
		pwms = <&pwm7 0 25000 0>;
        status = "disabled";
	};

    edp-panel {
        compatible = "simple-panel";
        backlight = <&backlight>;
        enable-gpios = <&gpio3 0x17 0x00>;
        enable-delay-ms = <100>;
        prepare-delay-ms = <200>;
        status = "disabled";
    
        display-timings {
            native-mode = <&edp_timing>;
    
            edp_timing: edp_timing {
                clock-frequency = <148500000>; // 80000000
                hactive = <1920>;
                hback-porch = <240>;
                hfront-porch = <20>;
                hsync-len = <2>;
                vactive = <1080>;
                vback-porch = <20>;
                vfront-porch = <32>;
                vsync-len = <2>;
                hsync-active = <0>;
                vsync-active = <0>;
                de-active = <0>;
                pixelclk-active = <0>;
            };
        };

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0x00>;
                edp_panel_ep: endpoint {
                    remote-endpoint = <&edp_psp1_ep>;
                };
            };
        };
    };

    lvds-panel {
		backlight = <&backlight>;
		bus-format = <0x1010>;
		compatible = "simple-panel";
		enable-delay-ms = <0x64>;
		init-delay-ms = <0x64>;
		prepare-delay-ms = <0xc8>;
		unprepare-delay-ms = <0xc8>;
		power-supply = <&vcc_3v3>;
		enable-gpios = <&gpio3 0x1d 0x00>;
        status = "disabled";

		display-timings {
			native-mode = <&lvds0_timing>;

			lvds0_timing: lvds_timing {
				clock-frequency = <80000000>;
                de-active = <0>;
                hactive = <1368>;
                hback-porch = <148>;
                hfront-porch = <88>;
                hsync-active = <0>;
                hsync-len = <44>;
                pixelclk-active = <0>;
                vactive = <768>;
                vback-porch = <36>;
                vfront-porch = <4>;
                vsync-active = <0>;
                vsync-len = <5>;
			};
		};

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0x00>;
                lvds0_panel_ep: endpoint {
                    remote-endpoint = <&lvds0_p1_ep>;
                };
            };
        };
	};

	lvds1-panel {
		backlight = <&backlight1>;
		bus-format = <0x1010>;
		compatible = "simple-panel";
		enable-delay-ms = <0x64>;
		init-delay-ms = <0x64>;
		prepare-delay-ms = <0xc8>;
		unprepare-delay-ms = <0xc8>;
		power-supply = <&vcc3v3_lcd0_n>;
        status = "disabled";

		display-timings {
			native-mode = <&lvds1_timing>;

			lvds1_timing: lvds1_timing {
				clock-frequency = <80000000>;
                de-active = <0>;
                hactive = <1366>;
                hback-porch = <148>;
                hfront-porch = <88>;
                hsync-active = <0>;
                hsync-len = <44>;
                pixelclk-active = <0>;
                vactive = <768>;
                vback-porch = <36>;
                vfront-porch = <4>;
                vsync-active = <0>;
                vsync-len = <5>;
			};
		};

		ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0x00>;

                lvds1_panel_ep: endpoint {
                    remote-endpoint = <&lvds1_p1_ep>;
                };
            };
		};
	};
    
    mipi-sequence {
		compatible = "mipi-sequence-innohi";
		panel-init-sequence = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 