		panel-init-sequence-size = <0x00>;
		panel-sequence-type = <0x00>;
		status = "disabled";
	};

    own-gpio {
		compatible = "gpio-innohi";
		pinctrl-0 = <&own_gpp>;
		pinctrl-names = "default";
		status = "disabled";
	};
    
    
	vcc-camera-regulator {
		status = "disabled";
		compatible = "regulator-fixed";
		enable-active-high;
		phandle = <0x216>;
		regulator-always-on;
		regulator-boot-on;
		regulator-name = "vcc_camera";  
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;        
	};
};

&chosen {
    stdout-path = "serial2:1500000n8";
    bootargs = "ro rootwait console=ttyS2,1500000 earlycon=uart8250,mmio32,0xfe660000,1500000";
    //bootargs = "storagemedia=emmc ro rootwait console=ttyFIQ0 earlycon=uart8250,mmio32,0xfe660000 chip=rk3568";
};

&backlight {
    default-brightness-level = <0x80>;
    lcd_backlight_max = <0xff>;
    lcd_backlight_min = <0x32>;
    lcd_pwm_pol = <0x01>;
    enable-gpios = <&gpio3 0x1c 0x00>;
    status = "disabled";
};

&backlight1 {
    default-brightness-level = <0x80>;
    lcd_backlight_max = <0xff>;
    lcd_backlight_min = <0x32>;
    lcd_pwm_pol = <0x01>;
    enable-gpios = <&gpio3 0x1c 0x00>;
    pwms = <&pwm7 0 25000 0>;
    status = "disabled";
};

&pinctrl {
	own_gpio {
		own_gpp: own-gpio-pins {
			rockchip,pins = <0x03 0x19 0x00 0x12c 0x03 0x1c 0x00 0x12c 0x03 0x1d 0x00 0x12c 0x00 0x06 0x00 0x12c 0x00 0x0f 0x00 0x12c 0x00 0x1b 0x00 0x12c 0x00 0x1c 0x00 0x12c 0x00 0x1d 0x00 0x12c 0x02 0x1d 0x00 0x12c 0x04 0x12 0x00 0x12c 0x04 0x13 0x00 0x12c 0x04 0x14 0x00 0x12c>;
		};
	};

    lcd0 {
        /omit-if-no-ref/
        lcd0gp: lcd0-rst-gpio {
			rockchip,pins = <0x03 0x1a 0x00 0x12c>;
		};
	};

    /omit-if-no-ref/
	i2c2m2_xfer: i2c2m2-xfer {
		rockchip,pins =
			<4 RK_PB5 0 &pcfg_pull_none_smt>,
			<4 RK_PB4 0 &pcfg_pull_none_smt>;
	};

    camera-pwr {
		rockchip,pins = <0x00 0x11 0x00 &pcfg_pull_none_smt>;
	};
};

&pmu_io_domains {
    vccio4-supply = <&vcc_1v8>;
};

&lvds0 {
    ports {
		port@1 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;

			lvds0_p1_ep: endpoint@0 {
				remote-endpoint = <&lvds0_panel_ep>;
			};
		};
    };
};

&lvds1 {
    ports {
		port@1 {
			reg = <0x01>;

			lvds1_p1_ep: endpoint {
				remote-endpoint = <&lvds1_panel_ep>;
			};
		};
    };
};

&i2c0 {
    rk809_1: pmic@20 {
        led_red_gpio = <&gpio0 0x06 0x00>;
		power-on-gpios = <&gpio0 0x1b 0x00 &gpio0 0x1c 0x00 &gpio0 0x1d 0x00 &gpio2 0x1d 0x00>;
        codec {
			hp-mute-delay-ms = <30>;
			mic-gain = <153>;
			hp-ctl-gpios = <&gpio3 0x1e 0x00>;
			spk-ctl-gpios = <&gpio2 0x1e 0x00>;
        };
        regulators {
            LDO_REG4 {
                regulator-max-microvolt = <3300000>;
                regulator-min-microvolt = <3300000>;
            };
        };
    };

   syr837@40 {
		compatible = "silergy,syr827";
		fcs,suspend-voltage-selector = <0x01>;
		reg = <0x40>;
		regulator-always-on;
		regulator-boot-on;
		regulator-compatible = "fan53555-reg";
		regulator-initial-state = <0x03>;
		regulator-init-microvolt = <900000>;
		regulator-max-microvolt = <1500000>;
		regulator-min-microvolt = <712500>;
		regulator-ramp-delay = <1000>;
		//regulator-name = "vdd_cpu";
        regulator-name = "vdd_cpu_little"; 
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-changeable-in-suspend;
			regulator-on-in-suspend;
			regulator-suspend-microvolt = <1100000>;
		};
	};

	syr838@41 {
		compatible = "silergy,syr828";
		fcs,suspend-voltage-selector = <0x01>;
		phandle = <0x18f>;
		reg = <0x41>;
		regulator-always-on;
		regulator-boot-on;
		regulator-compatible = "fan53555-reg";
		regulator-initial-state = <0x03>;
		regulator-init-microvolt = <900000>;
		regulator-max-microvolt = <1500000>;
		regulator-min-microvolt = <712500>;
		//regulator-name = "vdd_cpu";
		regulator-name = "vdd_cpu_big";
		regulator-ramp-delay = <1000>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-changeable-in-suspend;
			regulator-on-in-suspend;
			regulator-suspend-microvolt = <1100000>;
		};
	};
    
    tcs4525@1c {
        regulator-name = "vdd_gpu";
    };
    
	tcs4526@10 {
		compatible = "tcs,tcs452x";
		fcs,suspend-voltage-selector = <0x01>;
		phandle = <0x18b>;
		reg = <0x10>;
		regulator-always-on;
		regulator-boot-on;
		regulator-compatible = "fan53555-reg";
		regulator-initial-mode = <0x02>;
		regulator-init-microvolt = <900000>;
		regulator-max-microvolt = <1500000>;
		regulator-min-microvolt = <712500>;
		//regulator-name = "vdd_cpu";
        regulator-name = "vdd_npu"; 
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-changeable-in-suspend;
			regulator-on-in-suspend;
			regulator-suspend-microvolt = <1100000>;
		};
	};

    xz3215@60 {
		compatible = "xz3216";
		reg = <0x60>;

		regulators {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			regulator@0 {
				fcs,suspend-voltage-selector = <1>;
                reg = <0>;
                regulator-always-on;
                regulator-boot-on;
                regulator-compatible = "xz_dcdc1";
                regulator-initial-state = <3>;
                regulator-max-microvolt = <1400000>;
                regulator-min-microvolt = <600000>;
                //regulator-name = "vdd_cpu";
                regulator-name = "vdd_central"; 
                regulator-ramp-delay = <1000>;
                vin-supply = <&vcc5v0_sys>;

				regulator-state-mem {
					regulator-changeable-in-suspend;
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1100000>;
				};
			};
		};
	};
};

&i2c1 {
	focaltech@38 {
    	compatible = "focaltech,fts";
        reg = <0x38>;
        status = "disabled";
		focaltech,display-coords = <0x00 0x00 0x2d0 0x500>;
		focaltech,max-touch-number = <0x01>;
		focaltech,irq-gpio = <&gpio0 0x0d 0x08>;
		focaltech,reset-gpio = <&gpio0 0x0e 0x00>;
	};

	goodix_ts@5d {
		compatible = "goodix,gt9xx";
		reg = <0x5d>;
        status = "disabled";
		goodix,cfg-group = [41 58 02 00 04 05 35 00 01 18 28 0a 64 4b 03 05 00 00 00 00 00 00 06 18 1a 1e 14 8b 2b 0e 5f 61 31 0d 00 00 00 02 01 2c 23 00 00 00 00 03 64 32 00 00 00 50 82 94 d5 02 07 00 00 04 8d 54 00 83 5c 00 78 66 00 70 70 00 68 7b 00 68 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 04 06 08 0a 0c 0e 10 12 14 16 18 1a 1c ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff 00 02 04 06 08 0a 0c 0f 10 12 13 26 24 22 21 20 1f 1e 1d 1c 18 16 ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff 72 01];
		goodix,irq-gpio = <&gpio0 0x0d 0x08>;
		goodix,rst-gpio = <&gpio0 0x0e 0x00>;
		swap-x = <0x00>;
		swap-xy = <0x00>;
		swap-y = <0x00>;
	};

	ilitek@41 {
		compatible = "tchip,ilitek";
		reg = <0x41>;
        status = "disabled";
		ilitek,irq-gpio = <&gpio0 0x0d 0x08>;
		ilitek,name = "ilitek_i2c";
		ilitek,reset-gpio = <&gpio0 0x0e 0x00>;
	};

	sitronix@55 {
		compatible = "sitronix,cf1216";
		reg = <0x55>;
        status = "disabled";
		sitronix,interrupt-gpios = <&gpio0 0x0d 0x08>;
		sitronix,reset-gpios = <&gpio0 0x0e 0x00>;
	};
};

&i2c2 {
    pinctrl-names = "default", "gpio";
	pinctrl-0 = <&i2c2m1_xfer>, <&i2c2m2_xfer>;
    status = "okay";

	gc5025@37 {
		clock-names = "xvclk";
		clocks = <&cru CLK_CAM0_OUT>;
		compatible = "galaxycore,gc5025";
		pinctrl-0 = <&refclk_pins>;
		pinctrl-names = "default";
		power-domains = <&power 0x08>;
		reg = <0x37>;
		pwdn-gpios = <&gpio3 0x08 0x01>;
		reset-gpios = <&gpio3 0x05 0x01>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-index = <0x01>;
		rockchip,camera-module-lens-name = "CHT842-MD";
		rockchip,camera-module-name = "TongJu";
		status = "disabled";

		port {
			gc5025_ep: endpoint {
				data-lanes = <0x01 0x02>;
				remote-endpoint = <&csi2_dphy2_psp0_ep1>;
			};
		};
	};

	gc8034@37 {
		clock-names = "xvclk";
		clocks = <&cru CLK_CAM0_OUT>;
		compatible = "galaxycore,gc8034";
		pinctrl-0 = <&cif_clk>;
		pinctrl-names = "default";
		power-domains = <&power 0x08>;
		reg = <0x37>;
		pwdn-gpios = <&gpio4 0x0a 0x01>;
		reset-gpios = <&gpio3 0x06 0x01>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-index = <0x00>;
		rockchip,camera-module-lens-name = "CK8401";
		rockchip,camera-module-name = "RK-CMK-8M-2-v1";
		status = "disabled";

		port {
			gc8034_ep: endpoint {
				data-lanes = <0x01 0x02 0x03 0x04>;
				remote-endpoint = <&csi2_dphy0_psp0_ep1>;
			};
		};
	};

	gm8775@2c {
        clock-frequency = <80000000>;
        hactive = <1366>;
        vactive = <768>;
        hback-porch = <148>;
        hfront-porch = <88>;
        hsync-len = <44>;
        vback-porch = <36>;
        vfront-porch = <4>;
        vsync-len = <5>;
		compatible = "gm8775";
		lcd_bus_format = <0x01>;
		lcd_lvds_channel = <0x00>;
		lcd_lvds_swap = <0x00>;
		lcd_test_mode = <0x00>;
		reg = <0x2c>;
		status = "disabled";
	};

	lt8911@29 {
		compatible = "lt8911";
		reg = <0x29>;
        clock-frequency = <80000000>;
        hactive = <1366>;
        vactive = <768>;
        hback-porch = <148>;
        hfront-porch = <88>;
        hsync-len = <44>;
        vback-porch = <36>;
        vfront-porch = <4>;
        vsync-len = <5>;
		lcd_bus_format = <0x01>;
		lcd_test_mode = <0x00>;
		reset-gpios = <&gpio3 0x1a 0x01>;
		status = "disabled";
	};

	ov5695@36 {
		reg = <0x36>;
		clock-names = "xvclk";
		clocks = <&cru CLK_CIF_OUT>;
		compatible = "ovti,ov5695";
		pinctrl-0 = <&cif_clk>;
		pinctrl-names = "default";
		power-domains = <&power 0x08>;
		pwdn-gpios = <&gpio4 0x0a 0x00>;
		reset-gpios = <&gpio3 0x06 0x00>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-index = <0x00>;
		rockchip,camera-module-lens-name = "CHT842-MD";
		rockchip,camera-module-name = "TongJu";
		status = "disabled";

		port {
			ov5695_ep: endpoint {
				data-lanes = <0x01 0x02>;
				remote-endpoint = <&csi2_dphy1_psp0_ep1>;
			};
		};
	};
};

&i2c3 {
    clock-frequency = <50000>;
    status = "okay";
	pinctrl-0 = <&i2c3m1_xfer>;

    mcu@40 {
		compatible = "mcu";
		reg = <0x40>;
		status = "okay";
	};
};

&i2c4 {
	gc2145@3c {
		compatible = "galaxycore,gc2145";
		reg = <0x3c>;
		clock-names = "xvclk";
		clocks = <&cru 0xd6>;

		pinctrl-0 = <&cif_clk &cif_dvp_clk &cif_dvp_bus16>;
		pinctrl-names = "default";
		power-domains = <&power 0x08>;
		pwdn-gpios = <&gpio4 0x0a 0x00>;
		reset-gpios = <&gpio3 0x06 0x00>;
		//pwdn-gpios = <0x8a 0x06 0x00>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-index = <0x00>;
		rockchip,camera-module-lens-name = "Largan";
		rockchip,camera-module-name = "CameraKing";
		status = "disabled";

		port {
			gc2145_ep: endpoint {
				remote-endpoint = <&rkcif_dvp_ep>;
			};
		};
	};
};

&i2c5 {
	status = "okay";

	mxc6655xa@15 {
		status = "disabled";
	};

	rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		status = "okay";
                
	};
};

